{
  "expo": {
    "name": "LifeLink",
    "slug": "lifelink",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LifeLink to select your profile picture."
        }
      ]
    ]
  }
}
